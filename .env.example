# Copy to .env and fill in to enable real email delivery for the contact form.
# If SMTP_HOST is left unset, submissions are only written to
# contact_submissions.log (the app still works with no configuration).

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM=your-address@gmail.com
CONTACT_TO=amit.d070@gmail.com

# Optional runtime settings
# FLASK_DEBUG=1
# PORT=5000
